# Copy this file to .env.local in the project root and replace placeholders there.
# Keep real values out of this committed example.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Legacy alternative for code that reads NEXT_PUBLIC_SUPABASE_ANON_KEY:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Use the variable your client code reads; there is no automatic fallback.
# Never put a secret or service_role key in a NEXT_PUBLIC_ variable.
